<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mtgpuzzle</groupId>
    <artifactId>forge-adapter</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <forge.version>2.0.15</forge.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Forge の res ディレクトリ（cardsfolder, editions など） -->
        <forge.res>${project.basedir}/../forge/forge-gui/res</forge.res>
        <extraArgLine></extraArgLine>
    </properties>

    <dependencies>
        <!-- C3: forge-ai には依存しない。マナ・コストの支払いと既定の選択は Adapter 側で実装している -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${forge.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <forge.res>${forge.res}</forge.res>
                        <puzzles.dir>${project.basedir}/../puzzles</puzzles.dir>
                    </systemPropertyVariables>
                    <argLine>-Xmx2g -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 ${extraArgLine}</argLine>
                </configuration>
            </plugin>
            <!-- ブラウザ（V2）向けに依存込みの 1 jar を作る: target/forge-adapter-all.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>forge-adapter-all</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
