<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mtgpuzzle</groupId>
    <artifactId>forge-adapter</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <forge.version>2.0.15</forge.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Forge の res ディレクトリ（cardsfolder, editions など） -->
        <forge.res>${project.basedir}/../forge/forge-gui/res</forge.res>
        <extraArgLine></extraArgLine>
        <!-- CheerpJ で止まらない形に書き換えた Forge のクラス（design/forge-overlay.md）。ビルドのたびに Forge のソースから作る -->
        <forge.src>${project.basedir}/../forge</forge.src>
        <forge.overlay.dir>${project.build.directory}/generated-sources/forge-overlay</forge.overlay.dir>
        <!-- off で上書きなし（CheerpJ の不具合が直ったかを確かめるとき。ForgeOverlayTest は失敗する） -->
        <forge.overlay>on</forge.overlay>
        <!-- Windows で python3 が無ければ -Dpython=python など -->
        <python>python3</python>
    </properties>

    <dependencies>
        <!-- C3: forge-ai には依存しない。マナ・コストの支払いと既定の選択は Adapter 側で実装している -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${forge.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Forge のクラスの上書きを生成する（tools/forge-overlay/generate.py）。形が想定と違えばビルドを止める -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>forge-overlay</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${python}</executable>
                            <arguments>
                                <argument>${project.basedir}/../../tools/forge-overlay/generate.py</argument>
                                <argument>--forge</argument>
                                <argument>${forge.src}</argument>
                                <argument>--version</argument>
                                <argument>${forge.version}</argument>
                                <argument>--out</argument>
                                <argument>${forge.overlay.dir}</argument>
                                <argument>--overlay</argument>
                                <argument>${forge.overlay}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 生成したソースを、forge-adapter のソースとしてコンパイルする（jar で forge-game の同じクラスより前に来る） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>forge-overlay-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${forge.overlay.dir}</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <forge.res>${forge.res}</forge.res>
                        <puzzles.dir>${project.basedir}/../puzzles</puzzles.dir>
                    </systemPropertyVariables>
                    <argLine>-Xmx2g -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 ${extraArgLine}</argLine>
                </configuration>
            </plugin>
            <!-- ブラウザ（V2）向けに依存込みの 1 jar を作る: target/forge-adapter-all.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>forge-adapter-all</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
